# Server
PORT=3000
NODE_ENV=production

# PostgreSQL connection
DATABASE_URL=postgres://auction_user:change_me@localhost:5432/auction_db

# Session
SESSION_SECRET=change_me_to_a_long_random_string

# Set to "true" ONLY after HTTPS is actually working (see DEPLOY.md step 12).
# If you turn this on before HTTPS is set up, login will appear to succeed
# but immediately bounce back to the login page, because the browser refuses
# to send a Secure cookie over plain HTTP.
COOKIE_SECURE=false

# Shared login password. This ONLY seeds the password the very first time the
# server starts (into the DB) - after that it's ignored, and the password is
# managed via the "パスワード変更" button in the app itself. Editing this value
# later and restarting will NOT change an already-seeded password.
APP_PASSWORD=change_me

# Separate admin-only secret required to actually use "パスワード変更". Anyone
# who knows APP_PASSWORD can log in and search, but only someone who also
# knows ADMIN_PASSWORD can change the shared login password. Like APP_PASSWORD,
# this ONLY seeds the initial value on first startup - after that it's managed
# via the "管理者パスワード" tab in the app (which itself requires the current
# admin password to change). Keep it known only to whoever should administer
# the system (e.g. the client).
ADMIN_PASSWORD=change_me_admin_only

# Trust the nginx reverse proxy (needed for secure cookies behind HTTPS)
TRUST_PROXY=1
