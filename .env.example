# Server
PORT=3000
NODE_ENV=production

# PostgreSQL connection
DATABASE_URL=postgres://auction_user:change_me@localhost:5432/auction_db

# Session
SESSION_SECRET=change_me_to_a_long_random_string

# Set to "true" ONLY after HTTPS is actually working (see DEPLOY.md step 12).
# If you turn this on before HTTPS is set up, login will appear to succeed
# but immediately bounce back to the login page, because the browser refuses
# to send a Secure cookie over plain HTTP.
COOKIE_SECURE=false

# Shared login password (first-version simple auth)
APP_PASSWORD=change_me

# Trust the nginx reverse proxy (needed for secure cookies behind HTTPS)
TRUST_PROXY=1
