[Unit]
Description=Auction price database search system
After=network.target postgresql.service

[Service]
Type=simple
# Change this if your VPS admin/deploy user has a different name. Running as
# this user (rather than www-data) keeps the app directory's ownership
# consistent with whoever does `git pull` / edits files there day to day.
User=deploy
WorkingDirectory=/opt/auction-search
EnvironmentFile=/opt/auction-search/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
